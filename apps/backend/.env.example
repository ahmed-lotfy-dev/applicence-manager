DATABASE_URL=postgres://user:pass@host:5432/db
DB_SSL_MODE=disable
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
# Optional: use bcrypt hash instead of ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
LICENSE_TOKEN_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ACTIVATION_TOKEN_TTL_DAYS=30
FRONTEND_URL=http://localhost:3000
ACTIVATION_APP_NAME=business-manager
NODE_ENV=development
PORT=8000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL used to serve stored files, e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=
INVOICE_PDF_DIR=./storage/invoices
# Optional: custom font paths for PDF rendering (needed for Arabic text support)
# INVOICE_PDF_FONT_PATH=/absolute/path/to/Inter-Regular.ttf
# INVOICE_PDF_ARABIC_FONT_PATH=/absolute/path/to/NotoNaskhArabic-Regular.ttf
