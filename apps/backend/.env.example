# Database
DATABASE_URL=postgres://user:***@host:5432/db
# Server
NODE_ENV=development
PORT=8000

# Better Auth — public-facing URL of your app (where users start OAuth flows)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
# Optional: use bcrypt hash instead of ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash

# Tokens
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
LICENSE_TOKEN_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
ACTIVATION_TOKEN_TTL_DAYS=30
ACTIVATION_APP_NAME=business-manager

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Invoice PDF
INVOICE_PDF_DIR=./storage/invoices
# INVOICE_PDF_FONT_PATH=/absolute/path/to/Inter-Regular.ttf
# INVOICE_PDF_ARABIC_FONT_PATH=/absolute/path/to/NotoNaskhArabic-Regular.ttf
