{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:worker:pdf": "bun run --watch src/workers/invoice-pdf-worker.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "start:worker:pdf": "bun src/workers/invoice-pdf-worker.ts",
    "seed:admin": "bun run seed-admin-credential.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.16.0",
    "bun-types": "^1.3.9",
    "drizzle-kit": "^0.31.9",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "logixlysia": "^6.5.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "sharp": "^0.34.4",
    "zod": "^4.4.3"
  }
}