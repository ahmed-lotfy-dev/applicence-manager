{
  "name": "fawtarly-platform",
  "version": "0.1.0",
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.2.21",
  "private": true,
  "scripts": {
    "dev": "bun run dev:frontend & bun run dev:backend & bun run dev:worker:pdf & wait",
    "dev:backend": "bun run --filter backend dev",
    "dev:worker:pdf": "bun run --filter backend dev:worker:pdf",
    "dev:frontend": "bun run --filter frontend dev",
    "build": "bun run --filter \"*\" build",
    "build:backend": "bun run --filter backend build",
    "build:frontend": "bun run --filter frontend build",
    "start:backend": "bun run --filter backend start",
    "preview:frontend": "bun run --filter frontend preview"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "date-fns": "^4.2.1"
  }
}
